{
  "expo": {
    "name": "salesUp Capture",
    "slug": "salesup-capture",
    "version": "1.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "scheme": "salesupcapture",
    "icon": "./assets/icon.png",
    "ios": {
      "bundleIdentifier": "be.salesup.capture",
      "buildNumber": "1",
      "supportsTablet": false,
      "infoPlist": {
        "NSMicrophoneUsageDescription": "salesUp Capture neemt — na jouw expliciete start — gesprekken en meetings op voor kwaliteits- en trainingsdoeleinden.",
        "UIBackgroundModes": [
          "audio"
        ],
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "be.salesup.capture",
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MICROPHONE",
        "android.permission.MODIFY_AUDIO_SETTINGS"
      ]
    },
    "plugins": [
      [
        "expo-audio",
        {
          "microphonePermission": "salesUp Capture neemt — na jouw expliciete start — gesprekken en meetings op voor kwaliteits- en trainingsdoeleinden."
        }
      ],
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/icon.png",
          "imageWidth": 180,
          "resizeMode": "contain",
          "backgroundColor": "#1a2540"
        }
      ],
      [
        "expo-notifications",
        {
          "color": "#FF6B35"
        }
      ],
      "./plugins/withoutMediaPlaybackFgs.js"
    ],
    "extra": {
      "eas": {
        "projectId": "7d332190-814a-438d-8c50-6e89083e635e"
      }
    },
    "owner": "up-belgium",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/7d332190-814a-438d-8c50-6e89083e635e"
    }
  }
}
